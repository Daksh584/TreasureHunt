# Upstash Redis — set automatically when you connect Upstash via the Vercel Marketplace.
# Leave empty locally to use the in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (Alternative names, also supported)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: max failed scans / wrong team codes per IP per minute. Default 30.
# RATE_LIMIT_PER_MINUTE=30
# Optional: max team registrations per IP per minute. Default 20.
# REGISTER_LIMIT_PER_MINUTE=20

# Optional: pin the domain used in printed QR codes (default: the domain you're browsing).
# HUNT_BASE_URL=https://treasure-hunt.example.com
